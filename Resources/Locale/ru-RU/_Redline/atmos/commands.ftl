cmd-set-map-atmos-desc = Задаёт атмосферу для карты
cmd-set-map-atmos-help = setmapatmos <ID карты> <космос: true/false> [<температура> [моли газов...]]
cmd-set-map-atmos-removed = Атмосфера удалена с карты {$map}
cmd-set-map-atmos-updated = Атмосфера задана для карты {$map}
cmd-set-map-atmos-hint-map = <ID карты>
cmd-set-map-atmos-hint-space = <космос: true/false>
cmd-set-map-atmos-hint-temp = <температура> (дробное число)
cmd-set-map-atmos-hint-gas = <моли газа { $gas }> (дробное число)
